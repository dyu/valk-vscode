{
  "name": "valk",
  "displayName": "Valk language",
  "publisher": "valk-lang",
  "version": "0.0.10",
  "icon": "images/valk-logo.png",
  "repository": {
    "url": "https://github.com/valk-lang/valk-vscode"
  },
  "engines": {
    "vscode": "^1.79.0"
  },
  "activationEvents": [
    "onLanguage:valk",
    "workspaceContains:**/valk.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "valk.path": null
    },
    "languages": [
      {
        "id": "valk",
        "extensions": [
          ".valk"
        ],
        "configuration": "./language-config.json",
        "icon": {
          "light": "./images/valk-logo-spacing.png",
          "dark": "./images/valk-logo-spacing.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "valk",
        "scopeName": "source.valk",
        "path": "./syntax/valk.json"
      }
    ],
    "snippets": [
      {
        "language": "valk",
        "path": "./snippets/valk.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Valk",
      "properties": {
        "valk.path": {
          "scope": "window",
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Valk executable path"
        },
        "valk.lsp.enable": {
          "scope": "window",
          "type": [
            "boolean"
          ],
          "default": true,
          "description": "Valk enable language server"
        },
        "valk.lsp.debug": {
          "scope": "window",
          "type": [
            "boolean"
          ],
          "default": false,
          "description": "Valk LSP debug mode"
        },
        "valk.lsp.diagnosticsMode": {
          "scope": "window",
          "type": "string",
          "enum": [
            "save",
            "change"
          ],
          "enumDescriptions": [
            "Check diagnostics when a document is opened or saved.",
            "Check diagnostics after each coalesced edit batch."
          ],
          "default": "save",
          "description": "Controls when the Valk language server checks diagnostics."
        }
      }
    },
    "commands": [
      {
        "command": "valk.lsp.start",
        "title": "Start Valk Language Server",
        "category": "Valk"
      },
      {
        "command": "valk.lsp.stop",
        "title": "Stop Valk Language Server",
        "category": "Valk"
      },
      {
        "command": "valk.lsp.restart",
        "title": "Restart Valk Language Server",
        "category": "Valk"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test tests/grammar.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^16.x",
    "@types/vscode": "1.79.1",
    "typescript": "^5.9.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "vscode-languageclient": "8.2.0-next.3"
  }
}
