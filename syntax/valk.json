{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "valk",
    "scopeName": "source.valk",
    "fileTypes": ["valk"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#meta" },
        { "include": "#strings" },
        { "include": "#field-tags" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#functions" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.documentation.valk",
                    "begin": "///",
                    "end": "$",
                    "patterns": [{ "include": "#commentContents" }]
                },
                {
                    "name": "comment.line.double-slash.valk",
                    "begin": "//",
                    "end": "$",
                    "patterns": [{ "include": "#commentContents" }]
                }
            ]
        },
        "commentContents": {
            "patterns": [
                {
                    "match": "\\b(TODO|FIXME|NOTE)\\b:?",
                    "name": "keyword.todo.valk"
                }
            ]
        },
        "meta": {
            "patterns": [
                {
                    "name": "keyword.control.directive.valk",
                    "match": "^\\s*#(if|elif|else|end|loop|error|print)\\b"
                },
                {
                    "name": "keyword.control.directive.valk",
                    "match": "#(embed_dir|embed)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.raw.valk",
                    "begin": "\\br\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.valk",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.valk",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [{ "include": "#stringcontent" }]
                },
                {
                    "name": "string.quoted.single.valk",
                    "match": "'([^'\\\\]|\\\\([nrtbfvae0'\"\\\\]|x[0-9a-fA-F]{2}))'"
                }
            ]
        },
        "stringcontent": {
            "patterns": [
                {
                    "name": "constant.character.escape.valk",
                    "match": "\\\\([nrtbfvae0'\"\\\\%]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})"
                },
                {
                    "name": "invalid.illegal.unrecognized-string-escape.valk",
                    "match": "\\\\."
                },
                {
                    "name": "meta.interpolation.valk",
                    "begin": "%\\{",
                    "end": "\\}",
                    "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.valk" } },
                    "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.valk" } },
                    "patterns": [
                        {
                            "name": "meta.format-specifier.valk",
                            "match": "(?<!\\s)(:)(?!\\})((?:[^}\\\\\"]?[<>^])?[+\\- ]?#?0?[0-9]*(?:\\.[0-9]+)?[dxXbofeEs]?)(?=\\})",
                            "captures": {
                                "1": { "name": "punctuation.separator.format-specifier.valk" },
                                "2": { "name": "constant.other.placeholder.valk" }
                            }
                        },
                        {
                            "begin": "\\{",
                            "end": "\\}",
                            "patterns": [{ "include": "$self" }]
                        },
                        { "include": "$self" }
                    ]
                },
                {
                    "name": "variable.other.interpolated.valk",
                    "match": "%[_a-zA-Z][_a-zA-Z0-9]*"
                }
            ]
        },
        "field-tags": {
            "patterns": [
                {
                    "name": "meta.annotation.tag.valk",
                    "begin": "`",
                    "end": "`",
                    "beginCaptures": { "0": { "name": "punctuation.definition.tag.begin.valk" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.tag.end.valk" } },
                    "patterns": [{ "include": "#tag-entries" }]
                },
                {
                    "name": "meta.annotation.tag.valk",
                    "begin": "(?<!\\.)(\\$tag)(\\()",
                    "end": "\\)",
                    "beginCaptures": {
                        "1": { "name": "support.constant.valk" },
                        "2": { "name": "punctuation.section.arguments.begin.valk" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.section.arguments.end.valk" }
                    },
                    "patterns": [{ "include": "#tag-entries" }]
                }
            ]
        },
        "tag-entries": {
            "patterns": [
                {
                    "name": "string.quoted.double.valk",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.valk",
                            "match": "\\\\([nrtbfvae0'\"\\\\]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
                        },
                        {
                            "name": "invalid.illegal.unrecognized-string-escape.valk",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "match": "\\b([_a-zA-Z][_a-zA-Z0-9]*)(\\s*)(:)",
                    "captures": {
                        "1": { "name": "entity.other.attribute-name.valk" },
                        "3": { "name": "punctuation.separator.key-value.valk" }
                    }
                },
                {
                    "name": "entity.other.attribute-name.valk",
                    "match": "\\b[_a-zA-Z][_a-zA-Z0-9]*\\b"
                },
                {
                    "name": "punctuation.separator.valk",
                    "match": ","
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hexfloat.valk",
                    "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*(\\.[0-9a-fA-F][0-9a-fA-F_]*)?[pP][+-]?[0-9a-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.hexadecimal.valk",
                    "match": "\\b0x[a-fA-F0-9][a-fA-F0-9_]*\\b"
                },
                {
                    "name": "constant.numeric.binary.valk",
                    "match": "\\b0b[01][01_]*\\b"
                },
                {
                    "name": "constant.numeric.octal.valk",
                    "match": "\\b0[co][0-7][0-7_]*\\b"
                },
                {
                    "name": "constant.numeric.float.valk",
                    "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?|[eE][+-]?[0-9_]+)\\b"
                },
                {
                    "name": "constant.numeric.decimal.valk",
                    "match": "\\b[0-9][0-9_]*\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "(?<!\\.)\\b(if|else|while|each|match|return|break|continue|defer|throw|co|await|lock|as|skip)\\b",
                    "name": "keyword.control.valk"
                },
                {
                    "match": "(?<!\\.)\\binto\\b(?!\\s*[:=])",
                    "name": "keyword.control.valk"
                },
                {
                    "match": "(?<!\\.)\\bdefault(?=\\s*=>)",
                    "name": "keyword.control.valk"
                },
                {
                    "match": "^\\s*(?:([-~+]{1,3})\\s*)?(?:(extern|export)\\s+)?(shared)\\b(?=[ \\t]+(?!(?:is|is_a|as|into)\\b)[_a-zA-Z])",
                    "captures": {
                        "1": { "name": "keyword.operator.valk" },
                        "2": { "name": "keyword.other.valk" },
                        "3": { "name": "keyword.other.valk" }
                    }
                },
                {
                    "match": "(?<!\\.)\\b(copy|clone)\\b(?=[ \\t]+(?!(?:x|as|is|is_a|in|into|else)\\b)(?:[_a-zA-Z@]|&\\S))",
                    "name": "keyword.other.valk"
                },
                {
                    "match": "(?<!\\.)\\b(fn|let|const|class|struct|trait|interface|union|enum|alias|extend|use|link|extern|export|global|static|atomic|locked|local|mut|test|synctest|bench|is_a)\\b",
                    "name": "keyword.other.valk"
                },
                {
                    "match": "(?<!\\.)\\b(is|for|mode|type|value|get|set|group|packed)\\b(?!\\s*[:=])",
                    "name": "keyword.other.valk"
                },
                {
                    "match": "(?<!\\.)\\b(true|false|null|__PATH__|__FILE__|__DIR__|__LINE__)\\b",
                    "name": "constant.language.valk"
                },
                {
                    "match": "(?<!\\.)\\bthis\\b",
                    "name": "variable.language.valk"
                },
                {
                    "name": "keyword.other.intrinsic.valk",
                    "match": "@[_a-zA-Z][_a-zA-Z0-9]*\\b"
                },
                {
                    "name": "support.constant.valk",
                    "match": "\\$[_a-zA-Z][_a-zA-Z0-9]*\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "match": "\\b(void|bool|u8|u16|u32|u64|uint|i8|i16|i32|i64|int|f32|f64|float|ptr|cstring|fnptr|[uif](?:8|16|32|64)x(?:2|4|8|16|32|64))\\b",
                    "name": "support.type.primitive.valk"
                },
                {
                    "match": "\\b(SELF|String|Array|Map|HashMap|FlatMap|HashSet|BTreeMap|BTreeSet|BTreeRange|BTreeSetRange|Deque|Heap|ByteBuffer|ByteReader|Arena|ArenaView|Link|Lock|Weak|Fd|GenericError|SystemError|IterError|InitError|LookupError|SyntaxError)\\b",
                    "name": "support.type.valk"
                },
                {
                    "name": "constant.other.caps.valk",
                    "match": "\\b[A-Z][A-Z0-9_]+\\b"
                },
                {
                    "name": "entity.name.type.valk",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "(?<!\\.)\\b(isset|typeof|size_of|is_defined|nonnull|print|println|panic|assert|exit|raise|atomic_cas|atomic_load|atomic_store)(?=\\s*\\()",
                    "name": "support.function.builtin.valk"
                },
                {
                    "match": "\\b([_a-zA-Z][_a-zA-Z0-9]*)(?=\\s*\\()",
                    "name": "entity.name.function.valk"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.valk",
                    "match": "(<<=|>>=|\\.\\.\\.|!\\?|\\?!|!!|!>|\\?\\?|\\?\\.|=>|->|\\.\\.|<<|>>|<=|>=|==|!=|&&|\\|\\||\\+\\+|--|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=|!|\\*|\\+|-|/|&|\\^|\\||~|:|<|>|%|\\?)"
                }
            ]
        }
    }
}
