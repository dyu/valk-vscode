{
    "comments": {
        "lineComment": "//"
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^.*(\\{|\\[|\\()\\s*(//.*)?$",
        "decreaseIndentPattern": "^\\s*(\\}|\\]|\\)).*$"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*///\\s*$",
            "action": {
                "indent": "none",
                "removeText": 3
            }
        },
        {
            "beforeText": "^\\s*///.*$",
            "action": {
                "indent": "none",
                "appendText": "/// "
            }
        }
    ]
}
